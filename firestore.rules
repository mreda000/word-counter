rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player owns exactly the document whose ID is their Auth UID.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Required fields: progress (map, at most 120 records), updatedAt (server timestamp).
    function isValidPlayer(data) {
      return data.keys().hasAll(['progress', 'updatedAt'])
        && data.keys().hasOnly(['progress', 'updatedAt'])
        && data.progress is map && data.progress.size() <= 120
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }
    match /players/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidPlayer(request.resource.data);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
